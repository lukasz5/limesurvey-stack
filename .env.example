# Copy to .env (install.sh does this for you) and fill in the required values.

# --- Required ---
# Domain whose DNS A/AAAA record points at this server.
LS_DOMAIN=ankiety.example.com
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=admin@example.com
# E-mail of the first LimeSurvey administrator.
ADMIN_EMAIL=admin@example.com

# --- Optional ---
STACK_NAME=limesurvey
TZ=Europe/Warsaw
ADMIN_USER=admin
ADMIN_NAME=Administrator

# Restrict the admin panel to these networks (comma separated CIDRs).
# Default allows everyone; e.g. 203.0.113.10/32,198.51.100.0/24
ADMIN_ALLOW_CIDRS=0.0.0.0/0,::/0

# Use the Let's Encrypt staging CA while testing to avoid rate limits:
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# LimeSurvey release (GitHub tag) and SHA-256 of its source tarball.
LIMESURVEY_VERSION=7.10.0+261109
LIMESURVEY_SHA256=372551db149955883c4942d492c6c252ca31e55ad53e0561e1576d6d18e7c217
DB_TABLE_PREFIX=lime_

# Daily backup time (container TZ) and retention.
BACKUP_TIME=03:15
BACKUP_KEEP_DAYS=14

# Resource limits.
LIMESURVEY_MEM_LIMIT=1g
LIMESURVEY_CPUS=2
DB_MEM_LIMIT=1g
DB_BUFFER_POOL=256M
TRAEFIK_LOG_LEVEL=INFO
